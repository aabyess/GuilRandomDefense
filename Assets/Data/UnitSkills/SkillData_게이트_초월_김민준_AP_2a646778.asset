  m_Name: "SkillData_\uAC8C\uC774\uD2B8_\uCD08\uC6D4_\uAE40\uBBFC\uC900_AP_2a646778"
  m_EditorClassIdentifier: 
  skillName: "\uD574\uAD70\uC758 \uD64D\uC77C\uC810 \u2014 MANA\uAC8C\uC774\uC9C0135.00"
  description: "\uAC8C\uC774\uD2B8\uBCC4 \uBC30\uC815(ORIGINAL_UNLISTED_SKILL_EFFECTS.csv,
    2026-09-06): \uC6D0\uC791 \uD574\uAD70\uC758 \uD64D\uC77C\uC810(H05N)\uC758 \uAC8C\uC774\uD2B8
    \"MANA\uAC8C\uC774\uC9C0135.00\" \uB2A5\uB825 4\uAC1C\uB97C \uC774 SkillData
    \uD558\uB098\uB85C \uBB36\uC5C8\uB2E4.   \xB7 Tasigi_03#1: \uACC4\uC0B0\uC2DD
    400000.00   \xB7 Tasigi_03#2: \uACC4\uC0B0\uC2DD ((GetUnitStateSwap(UNIT_STATE_MAX_LIFE,s__TrigVariables__get  
    \xB7 Tasigi_03#3: \uACC4\uC0B0\uC2DD 400000.00   \xB7 Tasigi_03#4: \uACC4\uC0B0\uC2DD
    ((GetUnitStateSwap(UNIT_STATE_MAX_LIFE,s__TrigVariables__get  hitCount>1\uC740
    \"\uAC19\uC740 RRD \uC2DD\uC758 \uBC18\uBCF5\"\uC774\uC9C0 \uC2DC\uAC04\uCC28
    \uB2E4\uB2E8\uD788\uD2B8\uAC00 \uC544\uB2C8\uB2E4 \u2014 duration=0(\uC989\uC2DC
    \uC5F0\uC18D N\uD68C)\uC73C\uB85C \uADFC\uC0AC\uD588\uB2E4.  [Tasigi_03#2] A11S\uC2DD
    \uACC4\uC218(\uACC4\uC218 0.25+0.15\xD7\uB808\uBCA8/\uC5F0\uAD6C)\uB97C \uB808\uBCA81
    \uAE30\uC900\uC73C\uB85C \uACE0\uC815\uD574 \uACF1\uD588\uB2E4(\uC6D0\uC791 \uB808\uBCA81\uACFC
    \uB3D9\uC77C) \u2014 \uB808\uBCA8 \uCD95\uC774 \uC6B0\uB9AC\uC5D0 \uC5C6\uB2E4. 
    [Tasigi_03#4] A11S\uC2DD \uACC4\uC218(\uACC4\uC218 0.25+0.15\xD7\uB808\uBCA8/\uC5F0\uAD6C)\uB97C
    \uB808\uBCA81 \uAE30\uC900\uC73C\uB85C \uACE0\uC815\uD574 \uACF1\uD588\uB2E4(\uC6D0\uC791
    \uB808\uBCA81\uACFC \uB3D9\uC77C) \u2014 \uB808\uBCA8 \uCD95\uC774 \uC6B0\uB9AC\uC5D0
    \uC5C6\uB2E4. \u26A0\uFE0F 2026-09-06 \uC815\uC815(PM) \u2014 A11S\uB294 \uB300\uC0C1
    EnemyData.percentDamageTaken, \uC774\uBBF8 \uBCF4\uD3B8 \uC801\uC6A9. \uB450
    \uD6A8\uACFC \uB2E4 baked 0.40(0.25+0.15\xD71)\uC744 \uB098\uB220 \uC6D0\uB798
    \uACC4\uC218(0.10, CSV\uC758 \uB300\uC0C1\uCD5C\uB300\uCCB4\uB825\xD70.10\uACFC
    \uC815\uD655\uD788 \uC77C\uCE58)\uB9CC \uB0A8\uAE40 \u2014 \uC774\uC911 \uC801\uC6A9
    \uBC84\uADF8(0.40\xD70.90=0.36, \uC6D0\uC791 0.90 \uB300\uBE44 2.5\uBC30 \uACFC\uC18C).
    \u26A0\uFE0F 2026-09-06 \uCD94\uAC00 \uC815\uC815(PM \uC9C0\uC2DC\uB85C \uC7AC\uAC80\uD1A0,
    RRD_SEQUENCE_DUPLICATE_AUDIT.md \uC0AC\uB8401) \u2014 #1/#3(40\uB9CC)\uACFC #2/#4(\uB300\uC0C1\uCD5C\uB300\uCCB4\uB825\xD70.1)\uC740
    \uD655\uB960\uBD84\uAE30\uAC00 \uC544\uB2C8\uB77C \uC6D0\uC791 JASS\uC758 \uD0C0\uAC9F\uD305
    \uBC29\uC2DD if/else(Func003Func001C, \uC9C0\uC815\uB300\uC0C1 vs \uADF8\uB8F9\uBB34\uC791\uC704\uD53D)\uAC00
    \uD1B5\uC9F8\uB85C \uBCF5\uC0AC\uB418\uBA70 \uC0DD\uAE34 \uC644\uC804 \uC911\uBCF5\uC774\uB2E4.
    \uC6D0\uC791 \uC2E4\uC81C \uD310\uC815\uC740 \uD0C0\uAC9F\uD305 \uBC29\uC2DD\uACFC
    \uBB34\uAD00\uD558\uAC8C \uD56D\uC0C1 \"40\uB9CC \uD655\uC815\uD0C0 1\uAC1C +
    \uC870\uAC74\uBD80(\uB300\uC0C1 \uD3EC\uC778\uD2B8\uAC12<200, \uC6B0\uB9AC \uCD95
    \uBC16) \uCD5C\uB300\uCCB4\uB825\xD70.1 1\uAC1C\" = 2\uAC1C\uBFD0\uC774\uB2E4.
    #3\xB7#4(\uC911\uBCF5 \uC0AC\uBCF8)\uB97C \uC0AD\uC81C\uD588\uB2E4 \u2014 chance\uB97C
    \uAC74\uB4DC\uB9AC\uB294 \uBB38\uC81C\uAC00 \uC544\uB2C8\uB77C(\uB458 \uB2E4
    100% \uD655\uC815, \uC6D0\uC791\uC5D0\uB3C4 \uB79C\uB364\uC774 \uC5C6\uB2E4)
    \uC911\uBCF5 \uC81C\uAC70\uB2E4. \uC774\uC804\uC5D4 4\uAC1C \uB2E4 chance=1\uB85C
    40\uB9CC\xD72+\uCD5C\uB300\uCCB4\uB825\xD70.1\xD72 = \uC815\uD655\uD788 2\uBC30
    \uACFC\uB2E4\uC600\uB2E4. \u26A0\uFE0F 2026-09-06 \uB300\uC0C1\uC870\uAC74 \uBC30\uC120(PM
    \uC9C0\uC2DC) \u2014 #2(\uCD5C\uB300\uCCB4\uB825\xD70.1)\uC5D0 <200 \uC870\uAC74
    \uCD94\uAC00, #1(40\uB9CC \uD655\uC815\uD0C0)\uC740 \uC6D0\uC791\uB300\uB85C
    \uBB34\uC870\uAC74. \uC815\uC815(2026-09-07, \uB9AC\uC11C\uCE58\uB2F4\uB2F9 MULTIHIT_TYPE_C_SURVEY_2026-09-07.md/654f116,
    PM \uC9C0\uC2DC): hitCount\uB97C 2\u219211\uB85C \uC62C\uB838\uB2E4 \u2014 \uC6D0\uC791
    Trig_Tasigi_03_Func003Func002C\uC758 \uBC18\uBCF5 \uC0C1\uD55C\uC740 \"11 + GetUnitAbilityLevelSwapped('Aamk',
    \uCE90\uC2A4\uD130)\"\uC778 \uAC00\uBCC0 \uB8E8\uD504\uC778\uB370, \uC9C0\uAE08\uAE4C\uC9C0
    2\uB85C \uACE0\uC815\uB3FC \uC788\uC5B4 \uC6D0\uC791 \uCD5C\uC18C\uCE58(\uB808\uBCA80
    \uAE30\uC900 11\uD68C)\uC758 5\uBD84\uC758 1\uB3C4 \uC548 \uB410\uB2E4(\uD53C\uD574
    5.5\uBC30 \uACFC\uC18C). 'Aamk' \uC6D0\uBB38 \uC804\uC218 \uAC80\uC0C9(war3map_new.j,
    1\uAC74\uBFD0 \u2014 \uC774 \uC870\uAC74\uC2DD \uC790\uAE30 \uC790\uC2E0) + \uC804\uCCB4
    \uC720\uB2DB \uB370\uC774\uD130(war3map_new.w3u) \uC804\uC218 \uAC80\uC0C9 \uACB0\uACFC
    \uC774 \uB2A5\uB825\uC744 \uC2E4\uC81C\uB85C \uAC00\uC9C4 \uC720\uB2DB\uC774
    0\uAC74\uC774\uB77C GetUnitAbilityLevelSwapped\uB294 \uD56D\uC0C1 0\uC744 \uB3CC\uB824\uC900\uB2E4
    \u2014 \uC989 \"11+\uB808\uBCA8\"\uC774 \uC544\uB2C8\uB77C \uC2E4\uC9C8\uC801\uC73C\uB85C
    \uC5B8\uC81C\uB098 \uC815\uD655\uD788 11\uC774\uB2E4(\uB808\uBCA8 \uCD95\uC774
    \uC788\uB294\uB370 \uC548 \uC4F0\uB294 \uADFC\uC0AC\uAC00 \uC544\uB2C8\uB77C,
    \uC6D0\uC791 \uC790\uCCB4\uC5D0\uC11C \uADF8 \uB808\uBCA8 \uD56D\uC774 \uC8FD\uC5B4\uC788\uB294
    \uC0C1\uC218\uB2E4). #1(400000 \uD655\uC815\uD0C0)\xB7#2(\uCD5C\uB300\uCCB4\uB825\xD70.1\xD7A11S\uACC4\uC218,
    <200\uC870\uAC74)\uC774 \uAC19\uC740 \uB8E8\uD504 \uC548\uC5D0\uC11C \uD568\uAED8
    \uBC18\uBCF5\uB418\uBBC0\uB85C \uB458 \uB2E4 11\uB85C \uB9DE\uCD98\uB2E4. [\uCD08\uC6D4
    \uB098\uBA38\uC9C0 09-30] Tasigi_03 \uBC94\uC704 \uC14B \uCD94\uAC00(\uB300\uC0C1
    \uC911\uC2EC 525): \uC2DC\uC791 (400000 + AGI\xD75000) CHAOS/UNIVERSAL \xB7 \uBC18\uBCF5\uB9C8\uB2E4
    (380000 + STR\xD73500) MAGIC/UNIVERSAL \xD711 \xB7 \uB05D (350000 + AGI\xD75000)
    MAGIC/UNIVERSAL. \uBC18\uBCF5 \uC218\uB294 integerB < 11 + Aamk \uB808\uBCA8
    \u2014 H05N\uC5D4 Aamk\uAC00 \uC5C6\uC5B4 11\uD68C(\uC9C0\uAE08 \uAC12 \uADF8\uB300\uB85C).
    \u300C\uB300\uC0C1\uC774 \uC8FD\uC73C\uBA74 \uBB34\uC791\uC704 \uC801\uC73C\uB85C\u300D\xB7A11S
    \uACC4\uC218 (0.25+0.15L)\uB294 \uBBF8\uBC18\uC601. (Tools/apply_transcend_rest.py)"
