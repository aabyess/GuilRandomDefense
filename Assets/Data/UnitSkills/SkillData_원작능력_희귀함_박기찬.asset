    \uB0B4\uB9BC\uCC28\uC21C\uC73C\uB85C \uC815\uB82C\uD574 \uC21C\uC11C\uB300\uB85C
    \uC9DD\uC9C0\uC5C8\uB2E4. damageType\uC740 AD\uB85C \uD1B5\uC77C(\uC6D0\uC791
