    \uCD94\uAC00. \u26A0\uFE0F \uC6D0\uBB38\uC740 \u300C\uD3C9\uD0C0 \uB300\uC0C1\uC774
    PV\u2265200\uC77C \uB54C\uB9CC\u300D \uB3C4\uB294 \uBE14\uB85D \u2014 \uBC94\uC704
    \uD6A8\uACFC\uC5D0 PV\u2265200 \uC870\uAC74\uC744 \uAC78\uC5C8\uC73C\uB098 \uC774\uAC74
    \uB9DE\uB294 \uC801\uB9C8\uB2E4\uC758 \uC870\uAC74\uC774\uB77C, \uC8FC \uB300\uC0C1\uC774
