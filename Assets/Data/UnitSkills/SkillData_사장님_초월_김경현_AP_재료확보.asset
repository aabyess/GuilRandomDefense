  m_Name: "SkillData_\uC0AC\uC7A5\uB2D8_\uCD08\uC6D4_\uAE40\uACBD\uD604_AP_\uC7AC\uB8CC\uD655\uBCF4"
  m_EditorClassIdentifier: 
  skillName: "\uC7AC\uB8CC\uD655\uBCF4 \u2014 \uBAB9\uC0AD\uC81C(180\uCD08) + \uB178\uD68D\uBB3C
    \uD68D\uB4DD"
  description: "\uC0AC\uC7A5\uB2D8 10-06 \u300C\uBAB9\uC0AD\uC81C(\uB178\uD68D\uBB3C\uD68D\uB4DD
    180\uCD08)\u300D\xB7\u300C\uB178\uD68D\uBB3C\uD68D\uB4DD(\uCE58\uD0A8, \uB5A1\uBCF6\uC774,
    \uB3C8\uAE4C\uC2A4, \uD1A0\uC2A4\uD2B8, \uB9E5\uC8FC)\u300D. 180\uCD08\uB9C8\uB2E4
    \uC0AC\uAC70\uB9AC 700 \uC548 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC77C\uBC18 \uC801(\uBCF4\uC2A4\xB7PV\u2265200\xB7B06B
    \uC81C\uC678) 1\uAE30\uB97C \uC0AD\uC81C\uD558\uACE0 \uB178\uD68D\uBB3C 5\uC885
    \uC911 \uBB34\uC791\uC704 1\uAC1C\uB97C \uC5BB\uB294\uB2E4(\uC544\uC774\uD15C
    \uCE78 6\uCE78, \uAC00\uB4DD \uCC28\uBA74 \uBABB \uBC1B\uC74C). \uB178\uD68D\uBB3C\uC740
    \uB20C\uB7EC\uC11C \uD310\uB9E4 \u2014 37% \uB79C\uB364\uC704\uC2B5 1\uAE30,
    \uADF8\uC911 40% +100\uC5D4\xB7\uBAA9\uC7AC 1(\uC6D0\uC791 \uB808\uC77C\uB9AC
    \uB178\uD68D\uBB3C\uD488). \uD2B9\uC131\uAC15\uD654 2pt(\uB9DB\uC788\uB294\uC694\uB9AC)
    = \uB178\uD68D\uBB3C\uC744 \uC5BB\uC744 \uB54C 50% \uD655\uB960\uB85C 1\uAC1C
    \uB354."
