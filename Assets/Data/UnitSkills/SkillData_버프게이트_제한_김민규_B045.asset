  m_Script: {fileID: 11500000, guid: 9457f64cd84d34fd095791a069c0adc6, type: 3}
  m_Name: "SkillData_\uBC84\uD504\uAC8C\uC774\uD2B8_\uC81C\uD55C_\uAE40\uBBFC\uADDC_B045"
  m_EditorClassIdentifier: 
  skillName: "\uCE74\uD0C0\uCFE0\uB9AC \u2014 B045 \uCC3D(\uBC84\uD504 \uBD80\uC5EC,
    \uBC14\uB2E5+\uBE44\uC6A9)"
  description: "06\uBC88\u2460(2026-09-06, PM \uC9C0\uC2DC, 19ed606) \u2014 \uC6D0\uC791
    \uC0EC\uB86F \uCE74\uD0C0\uCFE0\uB9AC(h07I)\uC758 \uBC84\uD504 B045\uB294 \uB354\uBBF8
    Trig_katakuriAttack\uC774 \"1/7 AND LIFE>36\" \uC870\uAC74\uC73C\uB85C \uCE90\uC2A4\uD130
    \uC790\uC2E0\uC5D0\uAC8C \uAC78\uACE0, \uBC1C\uB3D9 \uC2DC LIFE\uB97C 17 \uAE4E\uB294\uB2E4(\uC624\uB354
    \uC2A4\uD2B8\uB9C1 \uD655\uC778). \"\uC815\uD655\uD788 N\uD0C0\uC9F8\"(hitCountThreshold)\uAC00
    \uC544\uB2C8\uB77C \"\uAC8C\uC774\uC9C0\uAC00 36\uC744 \uB118\uB294 \uB3D9\uC548
    \uACC4\uC18D\" + \uD655\uB960 \uD310\uC815\uC774\uB77C \uC2E0\uADDC \uD544\uB4DC
    SkillLevel.hitCountFloor(36)\uB85C \uB2F4\uC558\uB2E4 \u2014 \uC784\uACC4 \uB3C4\uB2EC
    \uC2DC \uC790\uB3D9 \uB9AC\uC14B\uB418\uB294 hitCountThreshold\uC640 \uB2EC\uB9AC
    \uC790\uB3D9 \uB9AC\uC14B\uC774 \uC5C6\uACE0, \uBC1C\uB3D9\uC5D0 \uC131\uACF5\uD588\uC744
    \uB54C\uB9CC(\uD655\uB960\uAE4C\uC9C0 \uD1B5\uACFC\uD588\uC744 \uB54C\uB9CC)
    gaugeSpendAmount(17)\uB9CC\uD07C \uAE4E\uB294\uB2E4(\uBE44\uC6A9\uC744 \uBE7C\uBA39\uC73C\uBA74
    \uC6D0\uC791\uBCF4\uB2E4 \uAC15\uD574\uC9C4\uB2E4, PM \uC9C0\uC2DC). \uC9C0\uC18D\uC2DC\uAC04(1.25\uCD08)\uC740
    \uD0C0\uC218\uB85C \uD658\uC0B0 \u2014 1.25\uCD08 \u2192 4\uB300(buffHitCharges=4).
    \uC18C\uBE44\uD558\uB294 \uCABD(SkillData_\uAC8C\uC774\uD2B8_\uC81C\uD55C_\uAE40\uBBFC\uADDC_136d09f9.asset,
    \"1/7 AND \uBC84\uD504B045==true\")\uC740 requiredBuffId=B045\uB9CC \uB9C8\uC800
    \uAC78\uBA74 \uC644\uC131\uB418\uB294\uB370, \uADF8 \uD30C\uC77C\uC774 \uC788\uB294
    Assets/Data/UnitSkills/\uB97C \uAD6C\uD604\uB2F4\uB2F91\uC774 \uC9C0\uAE08 \uAC19\uC774
    \uB9CC\uC9C0\uACE0 \uC788\uC5B4 \uC774\uBC88\uC5D4 \uC548 \uAC74\uB4DC\uB838\uB2E4(PM\uC5D0\uAC8C
    \uBCF4\uACE0, \uB514\uB809\uD130\uB9AC \uC548\uC804\uD574\uC9C0\uBA74 \uC774\uC5B4\uC11C
    \uC644\uC131). \uADF8\uB54C\uAE4C\uC9C0 \uC774 opener\uB294 \uAC78\uC5B4\uB46C\uB3C4
    \uBB34\uD574\uD558\uB2E4(\uBC1B\uC544 \uC4F0\uB294 \uCABD\uC774 \uC544\uC9C1
    \uC5C6\uC74C, LIFE \uAC8C\uC774\uC9C0 \uC18C\uBAA8\uB3C4 \uB2E4\uB978 \uC2A4\uD0AC\uACFC
    \uC548 \uACB9\uCE5C\uB2E4 \u2014 \uAE40\uBBFC\uADDC\uB294 \uC774 \uC2A4\uD0AC
    \uC804\uC5D0 OnHitCount/\uAC8C\uC774\uC9C0 \uC2A4\uD0AC\uC774 \uC5C6\uC5C8\uB2E4).
    \u26A0\uFE0F [\uCC28\uAC10 \uC2DC\uC810 \uC6D0\uC791 \uD655\uC778 \uB300\uAE30,
    2026-09-06 PM \uC9C0\uC2DC] \u2014 gaugeSpendAmount\uB97C \"\uD655\uB960 \uC131\uACF5
    \uC2DC\uC5D0\uB9CC\" \uAE4E\uB3C4\uB85D \uB9CC\uB4E4\uC5C8\uB294\uB370, \uAE30\uC874
    hitCountThreshold \uAC8C\uC774\uC9C0(resetTo)\uB294 \uBC18\uB300\uB85C \"\uD655\uB960
    \uC2E4\uD328\uD574\uB3C4 \uD56D\uC0C1\" \uB9AC\uC14B\uB41C\uB2E4(SkillLevel.triggerChance
    \uC8FC\uC11D, \"\uD655\uB960 \uD310\uC815\uACFC \uBCC4\uAC1C \uBE14\uB85D\uC774\uB77C
    \uC6D0\uC791\uB3C4 \uADF8\uB807\uB2E4\"). \uC870\uC0AC \uC6D0\uBB38(\"1/7 AND
    LIFE>36 \u2192 \uBC1C\uB3D9 \uC2DC LIFE\u221217\")\uC740 \uC131\uACF5 \uC2DC\uB85C
    \uC77D\uD788\uC9C0\uB9CC \uAE30\uC874 \uD328\uD134\uACFC \uBC18\uB300\uB77C \uB9AC\uC11C\uCE58\uB2F4\uB2F9
    \uD655\uC778 \uC804\uAE4C\uC9C0\uB294 \uD655\uC815 \uC544\uB2D8 \u2014 \uB2F5\uC774
    \uC624\uBA74 gaugeSpendAmount \uC801\uC6A9 \uC2DC\uC810(\uC131\uACF5 \uD6C4 \uC804\uC6A9
    vs \uD655\uB960\uACFC \uBB34\uAD00\uD558\uAC8C \uD56D\uC0C1)\uC744 \uB2E4\uC2DC
    \uBCFC \uAC83. \u26A0\uFE0F 2026-09-06 \uCD94\uAC00(\uB9AC\uC11C\uCE58\uB2F4\uB2F9
    SHORT_BUFF_WINDOW_GATES.md) \u2014 `buffHitCharges=4`\uB294 **\uC5F0\uAD6C 1\uB2E8\uACC4(\uC6D0\uC791\uC5D0\uC11C
    \uC2E4\uC81C\uB85C \uCF1C\uC9C0\uB294 \uCD5C\uC18C \uC0C1\uD0DC) \uAE30\uC900**\uC774\uB2E4(\uC5F0\uAD6C
    0\uB2E8\uACC4\uC5D0\uC11C\uB3C4 \uCE74\uD0C0\uCFE0\uB9AC\uB294 3.5\uD68C\uB85C
    \uD55C \uB300\uB294 \uB36E\uB294\uB2E4 \u2014 \uBE44\uBE44\xB7\uD578\uCF55\uC804\uC124\xB7\uC81C\uD2B8\xB7\uD578\uCF55\uC601\uC6D0
    \uB137\uACFC \uB2EC\uB9AC 0%\uAC00 \uC815\uC0C1\uC740 \uC544\uB2C8\uB2E4). \uC6B0\uB9AC\uC5D0
    \uC5F0\uAD6C\uC18C \uACF5\uC18D \uCD95\uC774 \uC544\uC9C1 \uC5C6\uC5B4 \uC2E4\uC81C
    \uBC1C\uB3D9\uB960\uC740 \uC774 \"1\uB2E8\uACC4\" \uAC00\uC815\uBCF4\uB2E4 \uB0AE\uAC8C
    \uB098\uC62C \uC218 \uC788\uB2E4. [\uCD08\uC6D4\xB7\uC81C\uD55C \uBE14\uB85D
    09-30] U3: B045 = A0R7(Ablo, Blo1 \uACF5\uC18D +400%, adur 1.25\uCD08) \u2014
    \u300C4\uD0C0 \uCDA9\uC804\u300D ApplyBuff \u2192 \uACF5\uC18D +400% 1.25\uCD08
    \uBC84\uD504(B045)\uB85C. Kata_03\uC774 \uC774 \uBC84\uD504 \uB3D9\uC548 \uB9E4
    \uD0C0. (Tools/apply_transcend_limited_blocks.py)"
