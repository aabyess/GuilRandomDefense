  m_EditorClassIdentifier:
  skillName: "\uC804\uC124\uC758 \uD6C4\uC608 :: Lv.1,\uC804\uC124\uC758 \uD6C4\uC608 :: Lv.2,\uC804\uC124\uC758 \uD6C4\uC608 :: Lv.3,\uC804\uC124\uC758 \uD6C4\uC608 :: Lv.4,\uC804\uC124\uC758 \uD6C4\uC608 :: Lv.5,\uC804\uC124\uC758 \uD6C4\uC608 :: Lv.6,\uC804\uC124\uC758 \uD6C4\uC608 :: Lv.7,\uC804\uC124\uC758 \uD6C4\uC608 :: Lv.8,\uC804\uC124\uC758 \uD6C4\uC608 :: Lv.9,\uC804\uC124\uC758 \uD6C4\uC608 :: Lv.10,\uC804\uC124\uC758 \uD6C4\uC608 :: Lv.11,\uC804\uC124\uC758 \uD6C4\uC608 :: Lv.12,\uC804\uC124\uC758 \uD6C4\uC608 :: Lv.13,\uC804\uC124\uC758 \uD6C4\uC608 :: Lv.14,\uC804\uC124\uC758 \uD6C4\uC608 :: Lv.15,\uC804\uC124\uC758 \uD6C4\uC608 :: Lv.16,\uC804\uC124\uC758 \uD6C4\uC608 :: Lv.17,\uC804\uC124\uC758 \uD6C4\uC608 :: Lv.18,\uC804\uC124\uC758 \uD6C4\uC608 :: Lv.19,\uC804\uC124\uC758 \uD6C4\uC608 \u2014 \uC790\uAE30 \uACF5\uACA9\uB825 +3000"
  description: "S2 2.323 \uC6D0\uC791 \uB808\uBCA0\uCE74 - \uC81C\uD55C(h05I) A0TA \u2014 \uAE30\uBCF8\uD6A8\uACFC : \uAE30\uBCF8 \uACF5\uACA9\uC2DC 325\uBC94\uC704 \uC2A4\uD50C\uB798\uC2DC \u00B7 \uCD94\uAC00\uD6A8\uACFC : \uC804\uC124\uC758 \uD6C4\uC608 \uC2A4\uD0AC \uB808\uBCA8\uB9CC\uD07C \uACF5\uACA9\uB825 3000 \uC99D\uAC00 \uBC0F \uC2A4\uD0AC \uB370\uBBF8\uC9C0 \uC99D\uAC00 \u3000\u25B6 \uC2A4\uD0AC \uBC1C\uB3D9\uC2DC\uB9C8\uB2E4 \uD655\uB960\uC801\uC73C\uB85C \uC2A4\uD0AC \uB808\uBCA8 \uC99D\uAC00 (\uCD5C\uB300 20\uB808\uBCA8) \u00B7 \uD604\uC7AC \uACF5\uACA9\uB825 \uC99D\uAC00\uB7C9 : 3000,\uC78A\uD600\uC9C4 \uCF5C\uB85C\uC138\uC6C0 \uAC80\uD22C\uC0AC \uC804\uC124\uC758 \uD6C4\uC608\uC785\uB2C8\uB2E4. \u00B7 \uAE30\uBCF8\uD6A8\uACFC : \uAE30\uBCF8 \uACF5\uACA9\uC2DC 325\uBC94\uC704 \uC2A4\uD50C\uB798\uC2DC \u00B7 \uCD94\uAC00\uD6A8\uACFC : \uC804\uC124\uC758 \uD6C4\uC608 \uC2A4\uD0AC \uB808\uBCA8\uB9CC\uD07C \uACF5\uACA9\uB825 3000 \uC99D\uAC00 \uBC0F \uC2A4\uD0AC \uB370\uBBF8\uC9C0 \uC99D\uAC00 \u3000\u25B6 \uC2A4\uD0AC \uBC1C\uB3D9\uC2DC\uB9C8\uB2E4 \uD655\uB960\uC801\uC73C\uB85C \uC2A4\uD0AC \uB808\uBCA8 \uC99D\uAC00 (\uCD5C\uB300 20\uB808\uBCA8) \u00B7 \uD604\uC7AC \uACF5\uACA9\uB825 \uC99D\uAC00\uB7C9 : 6000,\uC78A\uD600\uC9C4 \uCF5C\uB85C\uC138\uC6C0 \uAC80\uD22C\uC0AC \uC804\uC124\uC758 \uD6C4\uC608\uC785\uB2C8\uB2E4. \u00B7 \uAE30\uBCF8\uD6A8\uACFC : \uAE30\uBCF8 \uACF5\uACA9\uC2DC 325\uBC94\uC704 \uC2A4\uD50C\uB798\uC2DC \u00B7 \uCD94\uAC00\uD6A8\uACFC : \uC804\uC124\uC758 \uD6C4\uC608 \uC2A4\uD0AC \uB808\uBCA8\uB9CC\uD07C \uACF5\uACA9\uB825 3000 \uC99D\uAC00 \uBC0F \uC2A4\uD0AC \uB370\uBBF8\uC9C0 \uC99D\uAC00 \u3000\u25B6 \uC2A4\uD0AC \uBC1C\uB3D9\uC2DC\uB9C8\uB2E4 \uD655\uB960\uC801\uC73C\uB85C \uC2A4\uD0AC \uB808\uBCA8 \uC99D\uAC00 (\uCD5C\uB300 20\uB808\uBCA8) \u00B7 \uD604\uC7AC \uACF5\uACA9\uB825 \uC99D\uAC00\uB7C9 : 9000,\uC78A\uD600\uC9C4 \uCF5C\uB85C\uC138\uC6C0 \uAC80\uD22C\uC0AC \uC804\uC124\uC758 \uD6C4\uC608\uC785\uB2C8\uB2E4. \u00B7 \u