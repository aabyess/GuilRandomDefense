  m_Name: "SkillData_S2_\uC81C\uD55C_\uC774\uC720\uBC94_A0UA_2"
  m_EditorClassIdentifier:
  skillName: "\uC778\uC220 - \uBD84\uC2E0 :: Lv.2,\uC778\uC220 - \uBD84\uC2E0 :: Lv.Max \u2014 \uD3C9\uD0C0 \uBD80\uC18D"
  description: "S2 2.323 \uC6D0\uC791 \uC2DC\uB178\uBD80 - \uC81C\uD55C(h084) A0UA \u2014 \uBC1C\uB3D9\uC870\uAC74 : \uACF5\uACA9\uC2DC 9% \uD655\uB960\uB85C \uBD84\uC2E0 \uC18C\uD658 \u00B7 \uAE30\uBCF8\uD6A8\uACFC : \uBD84\uC2E0\uC740 \uB9E4 \uACF5\uACA9\uC2DC 300\uBC94\uC704 5\uB9CC \uB9C8\uBC95\uB370\uBBF8\uC9C0 \u3000\u25B6 \uBD84\uC2E0 \uC18C\uD658\uC2DC \uB2E8\uC77C\uC801 2.5\uCD08 \uC2A4\uD134 \u00B7 \uCD94\uAC00\uD6A8\uACFC : \uBD84\uC2E0\uB3C4 \uC554\uD589 \uC2A4\uD0AC\uC744 \uC0AC\uC6A9  \u3000\u25B6 \uC554\uD589 \uC2A4\uD0AC\uC758 \uBC1C\uB3D9 \uD655\uB960\uACFC \uD6A8\uACFC\uAC00 50%\uB85C \uAC10\uC18C\uB429\uB2C8\uB2E4.,\uBD84\uC2E0\uC744 \uC18C\uD658\uD569\uB2C8\uB2E4. \u00B7 \uBC1C\uB3D9\uC870\uAC74 : \uACF5\uACA9\uC2DC 9% \uD655\uB960\uB85C \uBD84\uC2E0 \uC18C\uD658 \u00B7 \uAE30\uBCF8\uD6A8\uACFC : \uBD84\uC2E0\uC740 \uB9E4 \uACF5\uACA9\uC2DC 300\uBC94\uC704 5\uB9CC \uB9C8\uBC95\uB370\uBBF8\uC9C0 \u3000\u25B6 \uBD84\uC2E0 \uC18C\uD658\uC2DC \uB2E8\uC77C\uC801 2.5\uCD08 \uC2A4\uD134 \u00B7 \uCD94\uAC00\uD6A8\uACFC : \uBD84\uC2E0\uB3C4 \uC554\uD589 \uC2A4\uD0AC\uC744 \uC0AC\uC6A9  \u3000\u25B6 \uC554\uD589 \uC2A4\uD0AC\uC758 \uBC1C\uB3D9 \uD655\uB960\uACFC \uD6A8\uACFC\uAC00 50%\uB85C \uAC10\uC18C\uB429\uB2C8\uB2E4.  \uB2E4\uC911\uBD84\uC2E0\uC220 \u00B7 \uBC1C\uB3D9\uC870\uAC74 : \uACF5\uACA9\uC2DC 5% \uD655\uB960\uB85C \uAC15\uD654\uB41C \uBD84\uC2E0 \uC18C\uD658 \u00B7 \uAE30\uBCF8\uD6A8\uACFC : \uBD84\uC2E0\uC740 \uB9E4 \uACF5\uACA9\uC2DC 300\uBC94\uC704 7\uB9CC \uB9C8\uBC95\uB370\uBBF8\uC9C0 \u3000\u25B6 \uBD84\uC2E0 \uC18C\uD658\uC2DC \uB2E8\uC77C\uC801 2.5\uCD08 \uC2A4\uD134 \u00B7 \uCD94\uAC00\uD6A8\uACFC : \uBD84\uC2E0\uB3C4 \uC554\uD589 \uC2A4\uD0AC\uC744 \uC0AC\uC6A9  \u3000\u25B6 \uC554\uD589 \uC2A4\uD0AC\uC758 \uBC1C\uB3D9 \uD655\uB960\uACFC \uD6A8\uACFC\uAC00 60%\uB85C \uAC10\uC18C\uB429\uB2C8\uB2E4."
