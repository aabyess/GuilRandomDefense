    \uC11E\uC778 \uAC83 \u2192 \uC81C\uAC70. \uB4A4\uC758 AIsr +25\uB294 ForGroup
    \uBC16 GetEnumUnit()(null)\uC774\uB77C \uC6D0\uC791\uC5D0\uC11C\uB3C4 \uC544\uBB34
